# Copy to .env.yieldshield-test.local (this name is gitignored) and
# replace placeholders with the isolated Supabase preview project's values.
# Use a publishable/anon key ONLY. Never put a service_role/secret key in VITE_ variables.
VITE_TEST_SUPABASE_PROJECT_ID=YOUR_ISOLATED_TEST_PROJECT_ID
VITE_TEST_SUPABASE_URL=https://YOUR_ISOLATED_TEST_PROJECT_ID.supabase.co
VITE_TEST_SUPABASE_ANON_KEY=YOUR_TEST_PUBLISHABLE_OR_ANON_KEY
