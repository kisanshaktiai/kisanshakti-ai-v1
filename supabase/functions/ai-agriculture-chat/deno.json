{
  "compilerOptions": {
    "lib": ["deno.window", "deno.unstable"],
    "strict": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-explicit-any", "require-await"]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true,
    "semiColons": true
  },
  "tasks": {
    "test": "deno test --allow-net --allow-env --allow-read",
    "lint": "deno lint",
    "check": "deno check index.ts"
  },
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.57.2"
  }
}
