{
  "language": "en",
  "intents": [
    {
      "id": "navigate.home",
      "patterns": ["go home", "take me home", "open home", "home screen", "main page"],
      "priority": "high",
      "offline": true,
      "action": "navigate",
      "route": "/app"
    },
    {
      "id": "navigate.back",
      "patterns": ["go back", "previous page", "back", "return"],
      "priority": "high",
      "offline": true,
      "action": "back"
    },
    {
      "id": "navigate.lands",
      "patterns": ["show my lands", "open lands", "view my farms", "my fields", "land management"],
      "priority": "high",
      "offline": true,
      "action": "navigate",
      "route": "/app/lands"
    },
    {
      "id": "navigate.weather",
      "patterns": ["show weather", "what's the weather", "weather forecast", "check weather", "open weather"],
      "priority": "high",
      "offline": true,
      "action": "navigate",
      "route": "/app/weather"
    },
    {
      "id": "navigate.schedule",
      "patterns": ["show schedule", "my tasks", "open calendar", "what's on schedule", "farming schedule"],
      "priority": "high",
      "offline": true,
      "action": "navigate",
      "route": "/app/schedule"
    },
    {
      "id": "navigate.chat",
      "patterns": ["open chat", "talk to assistant", "ai assistant", "help me", "ask question"],
      "priority": "high",
      "offline": false,
      "action": "navigate",
      "route": "/app/chat"
    },
    {
      "id": "navigate.market",
      "patterns": ["open market", "marketplace", "buy products", "sell crops", "market prices"],
      "priority": "medium",
      "offline": true,
      "action": "navigate",
      "route": "/app/market"
    },
    {
      "id": "navigate.profile",
      "patterns": ["my profile", "open profile", "account settings", "user profile"],
      "priority": "medium",
      "offline": true,
      "action": "navigate",
      "route": "/app/profile"
    },
    {
      "id": "navigate.community",
      "patterns": ["open community", "social feed", "farmer community", "connect with farmers"],
      "priority": "medium",
      "offline": false,
      "action": "navigate",
      "route": "/app/social"
    },
    {
      "id": "navigate.menu",
      "patterns": ["open menu", "show menu", "main menu", "navigation menu"],
      "priority": "medium",
      "offline": true,
      "action": "ui_action",
      "params": { "action": "open_menu" }
    },
    {
      "id": "navigate.close_menu",
      "patterns": ["close menu", "hide menu", "dismiss menu"],
      "priority": "medium",
      "offline": true,
      "action": "ui_action",
      "params": { "action": "close_menu" }
    },
    {
      "id": "crud.create_land",
      "patterns": ["add new land", "register new field", "add farm", "create new land", "new land"],
      "slots": [
        { "name": "landName", "type": "string", "required": false },
        { "name": "area", "type": "number", "required": false }
      ],
      "priority": "high",
      "offline": false,
      "action": "navigate",
      "route": "/app/add-land"
    },
    {
      "id": "crud.edit_land",
      "patterns": ["edit land", "update land", "modify field", "change land details"],
      "slots": [
        { "name": "landId", "type": "string", "required": false },
        { "name": "landName", "type": "string", "required": false }
      ],
      "priority": "high",
      "offline": false,
      "action": "edit",
      "params": { "entity": "land" }
    },
    {
      "id": "crud.delete_land",
      "patterns": ["delete land", "remove field", "delete this land", "remove this field"],
      "slots": [
        { "name": "landId", "type": "string", "required": false }
      ],
      "priority": "high",
      "offline": false,
      "action": "delete",
      "params": { "entity": "land", "requiresConfirmation": true }
    },
    {
      "id": "crud.create_task",
      "patterns": ["add task", "create task", "new task", "add reminder"],
      "slots": [
        { "name": "title", "type": "string", "required": true },
        { "name": "date", "type": "date", "required": false },
        { "name": "priority", "type": "enum", "required": false, "values": ["low", "medium", "high"] }
      ],
      "priority": "high",
      "offline": false,
      "action": "create",
      "params": { "entity": "task" }
    },
    {
      "id": "crud.delete_task",
      "patterns": ["delete task", "remove task", "cancel task", "delete this task"],
      "slots": [
        { "name": "taskId", "type": "string", "required": false }
      ],
      "priority": "high",
      "offline": false,
      "action": "delete",
      "params": { "entity": "task", "requiresConfirmation": true }
    },
    {
      "id": "form.next_field",
      "patterns": ["next field", "next", "go to next", "move forward"],
      "priority": "medium",
      "offline": true,
      "action": "form_action",
      "params": { "action": "next_field" }
    },
    {
      "id": "form.previous_field",
      "patterns": ["previous field", "previous", "go back", "move back"],
      "priority": "medium",
      "offline": true,
      "action": "form_action",
      "params": { "action": "previous_field" }
    },
    {
      "id": "form.clear_field",
      "patterns": ["clear field", "clear this", "erase", "delete this"],
      "priority": "medium",
      "offline": true,
      "action": "form_action",
      "params": { "action": "clear_field" }
    },
    {
      "id": "form.save",
      "patterns": ["save", "submit", "save this", "submit form", "save changes"],
      "priority": "high",
      "offline": false,
      "action": "form_action",
      "params": { "action": "save" }
    },
    {
      "id": "form.cancel",
      "patterns": ["cancel", "discard", "don't save", "cancel changes", "go back"],
      "priority": "high",
      "offline": true,
      "action": "form_action",
      "params": { "action": "cancel" }
    },
    {
      "id": "form.type_text",
      "patterns": ["type", "enter", "write"],
      "slots": [
        { "name": "text", "type": "string", "required": true }
      ],
      "priority": "medium",
      "offline": true,
      "action": "form_action",
      "params": { "action": "type_text" }
    },
    {
      "id": "confirm.yes",
      "patterns": ["yes", "confirm", "ok", "sure", "proceed", "do it"],
      "priority": "high",
      "offline": true,
      "action": "confirm",
      "params": { "confirmation": true }
    },
    {
      "id": "confirm.no",
      "patterns": ["no", "cancel", "stop", "don't", "never mind"],
      "priority": "high",
      "offline": true,
      "action": "confirm",
      "params": { "confirmation": false }
    },
    {
      "id": "help.repeat",
      "patterns": ["repeat", "say again", "what did you say", "repeat that"],
      "priority": "medium",
      "offline": true,
      "action": "help",
      "params": { "type": "repeat" }
    },
    {
      "id": "help.examples",
      "patterns": ["help", "what can you do", "show examples", "help me", "commands"],
      "priority": "medium",
      "offline": true,
      "action": "help",
      "params": { "type": "examples" }
    },
    {
      "id": "help.slow_down",
      "patterns": ["slow down", "speak slower", "slower please"],
      "priority": "medium",
      "offline": true,
      "action": "help",
      "params": { "type": "slow_down" }
    },
    {
      "id": "accessibility.read_screen",
      "patterns": ["read screen", "what's on screen", "read this", "tell me what you see"],
      "priority": "medium",
      "offline": true,
      "action": "accessibility",
      "params": { "action": "read_screen" }
    },
    {
      "id": "action.undo",
      "patterns": ["undo", "undo that", "go back", "reverse", "cancel that"],
      "priority": "high",
      "offline": true,
      "action": "undo"
    },
    {
      "id": "emergency.call_support",
      "patterns": ["call support", "contact support", "emergency", "need help", "urgent help"],
      "priority": "high",
      "offline": false,
      "action": "emergency",
      "params": { "type": "support" }
    },
    {
      "id": "query.weather_today",
      "patterns": ["how's the weather today", "today's weather", "will it rain today", "temperature today"],
      "priority": "high",
      "offline": false,
      "action": "query",
      "params": { "type": "weather", "timeframe": "today" }
    }
  ],
  "examples": [
    "Go home",
    "Show my lands",
    "What's the weather?",
    "Add new land",
    "Delete this task",
    "Save changes",
    "Help me"
  ]
}
